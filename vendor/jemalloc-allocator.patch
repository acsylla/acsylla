+// jemalloc built by acsylla (see install-jemalloc in Makefile). The driver allocates
+// in its IO threads and frees in the application threads and the other way around,
+// jemalloc handles it much better than the system allocator. Constant initialization,
+// so it is set before any static object of the driver allocates memory.
+extern "C" {
+void* acsylla_je_malloc(size_t size);
+void* acsylla_je_realloc(void* ptr, size_t size);
+void acsylla_je_free(void* ptr);
+}
+
+CassMallocFunction Memory::malloc_func_ = acsylla_je_malloc;
+CassReallocFunction Memory::realloc_func_ = acsylla_je_realloc;
+CassFreeFunction Memory::free_func_ = acsylla_je_free;
 
