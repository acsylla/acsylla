+    for (HostMap::const_iterator it = hosts_.begin(), end = hosts_.end(); it != end; ++it) {
+      const Host::Ptr& known = it->second;
+      if (!known->has_host_id() ||
+          known->host_id().time_and_version != host->host_id().time_and_version ||
+          known->host_id().clock_seq_and_node != host->host_id().clock_seq_and_node) {
+        continue;
+      }
+      if (known->address() == host->address()) {
+        // Already added, e.g. by both the NEW_NODE and the UP event of the node
+        LOG_DEBUG("Host %s is already added", host->address_string().c_str());
+        return;
+      }
+      old_addresses.push_back(known->address());
+    }
+    // The node changed its address, the old address is not removed by an event
+    for (Vector<Address>::const_iterator it = old_addresses.begin(), end = old_addresses.end();
+         it != end; ++it) {
+      LOG_INFO("Host %s is now %s, removing the old address", it->to_string().c_str(),
+               host->address_string().c_str());
+      notify_host_remove(*it);
+    }
+  }
+  notify_host_add(host);
+}
 
