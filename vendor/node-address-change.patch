+void ControlConnection::schedule_refresh_node(RefreshNodeType type, const Address& address,
+                                              int attempt, uint64_t delay_ms) {
+  RefreshNodeRetry retry = { type, address, attempt, uv_now(loop()) + delay_ms };
+  refresh_node_retries_.push_back(retry);
+  if (type == NEW_NODE) {
+    refreshing_new_nodes_.insert(address);
+  }
+  start_refresh_node_timer();
+}
+
+void ControlConnection::start_refresh_node_timer() {
+  if (refresh_node_retries_.empty()) return;
+  uint64_t due_ms = refresh_node_retries_.front().due_ms;
+  for (Vector<RefreshNodeRetry>::const_iterator it = refresh_node_retries_.begin(),
+                                                end = refresh_node_retries_.end();
+       it != end; ++it) {
+    due_ms = std::min(due_ms, it->due_ms);
+  }
+  uint64_t now_ms = uv_now(loop());
+  refresh_node_timer_.start(loop(), due_ms > now_ms ? due_ms - now_ms : 0,
+                            bind_callback(&ControlConnection::on_refresh_node_timer, this));
+}
+
+void ControlConnection::on_refresh_node_timer(Timer* timer) {
+  uint64_t now_ms = uv_now(loop());
+  Vector<RefreshNodeRetry> due;
+  Vector<RefreshNodeRetry> later;
+  for (Vector<RefreshNodeRetry>::const_iterator it = refresh_node_retries_.begin(),
+                                                end = refresh_node_retries_.end();
+       it != end; ++it) {
+    (it->due_ms <= now_ms ? due : later).push_back(*it);
+  }
+  refresh_node_retries_.swap(later);
+  if (!connection_->is_closing()) {
+    for (Vector<RefreshNodeRetry>::const_iterator it = due.begin(), end = due.end(); it != end;
+         ++it) {
+      refresh_node(it->type, it->address, it->attempt);
     }
   }
+  start_refresh_node_timer();
 }
 
