+bool ConnectionPool::learn_shards() {
+  // A pool created while its host was down does not know the shards of the host, it has a single
+  // slot for all its connections. The first connection to the host tells them.
+  const auto& si = host_->sharding_info();
+  if (!si || si->get_shards_count() <= connections_by_shard_.size()) return false;
+  const auto hosts_shard_cnt = si->get_shards_count();
+  LOG_INFO("Connection pool (%p) of host %s learned that the host has %u shards",
+           static_cast<void*>(this), address().to_string().c_str(),
+           static_cast<unsigned>(hosts_shard_cnt));
+  connections_by_shard_.resize(hosts_shard_cnt);
+  num_connections_per_shard_ = settings_.num_connections_per_host / hosts_shard_cnt
+      + (settings_.num_connections_per_host % hosts_shard_cnt ? 1u : 0u);
+  return true;
+}
