+TabletReplicas::ConstPtr TabletReplicas::resolve(const TabletReplicaId* ids, size_t count,
+                                                 const TabletHostResolver& hosts) {
+  SharedRefPtr<TabletReplicas> replicas(new TabletReplicas(ids, count, hosts.pools_version()));
+  for (size_t i = 0; i < count; ++i) {
+    Host::Ptr host = hosts.find_host(ids[i].host_id);
+    if (host) {
+      replicas->hosts_->push_back(host);
+      replicas->shards_.push_back(ids[i].shard);
+    }
+  }
+  return replicas;
+}
+
+int32_t TabletReplicas::shard(const Host* host) const {
+  // A tablet has as many replicas as the replication factor, a linear search is the fastest
+  for (size_t i = 0; i < hosts_->size(); ++i) {
+    if ((*hosts_)[i]->address() == host->address()) {
+      return shards_[i];
+    }
+  }
+  return -1;
+}
+
+bool TabletReplicas::has_ids(const TabletReplicaIds& ids) const {
+  if (ids.size() != ids_.size()) return false;
+  for (size_t i = 0; i < ids.size(); ++i) {
+    if (ids[i].shard != ids_[i].shard ||
+        ids[i].host_id.time_and_version != ids_[i].host_id.time_and_version ||
+        ids[i].host_id.clock_seq_and_node != ids_[i].host_id.clock_seq_and_node) {
+      return false;
+    }
+  }
+  return true;
+}
+
+const String& TabletMap::table_key(const StringRef& keyspace, const StringRef& table) const {
+  key_.assign(keyspace.data(), keyspace.size());
+  key_.push_back('.');
+  key_.append(table.data(), table.size());
+  return key_;
+}
+
+TabletReplicas::ConstPtr TabletMap::find(const StringRef& keyspace, const StringRef& table,
+                                         int64_t token, const TabletHostResolver& hosts) {
+  Map<String, TabletVec>::iterator it = tables_.find(table_key(keyspace, table));
+  if (it == tables_.end()) {
+    return TabletReplicas::ConstPtr();
+  }
+  TabletVec& tablets = it->second;
+  // The first tablet that ends at the token or after it
+  TabletVec::iterator tablet =
+      std::lower_bound(tablets.begin(), tablets.end(), token,
+                       [](const Tablet& tablet, int64_t token) { return tablet.last_token < token; });
+  if (tablet == tablets.end() || token <= tablet->first_token) {
+    return TabletReplicas::ConstPtr();
+  }
+  if (tablet->replicas->is_stale(hosts)) {
+    // Requests in flight keep the replicas they have, the tablet gets new ones
+    const Vector<TabletReplicaId>& ids = tablet->replicas->ids();
+    tablet->replicas = TabletReplicas::resolve(ids.data(), ids.size(), hosts);
+  }
+  return tablet->replicas;
+}
+
+TabletReplicas::ConstPtr TabletMap::update(const StringRef& keyspace, const StringRef& table,
+                                           int64_t first_token, int64_t last_token,
+                                           const TabletReplicaIds& ids,
+                                           const TabletHostResolver& hosts) {
+  TabletVec& tablets = tables_[table_key(keyspace, table)];
+  // Tablets (a, b] and (first_token, last_token] overlap when a < last_token and first_token < b.
+  // The tablets are sorted, so the ones that overlap the new tablet come one after another.
+  TabletVec::iterator begin = std::upper_bound(
+      tablets.begin(), tablets.end(), first_token,
+      [](int64_t first_token, const Tablet& tablet) { return first_token < tablet.last_token; });
+  TabletVec::iterator end = begin;
+  while (end != tablets.end() && end->first_token < last_token) {
+    ++end;
+  }
+  if (end - begin == 1 && begin->first_token == first_token && begin->last_token == last_token &&
+      begin->replicas->has_ids(ids) && !begin->replicas->is_stale(hosts)) {
+    return TabletReplicas::ConstPtr();
+  }
+  Tablet tablet = { first_token, last_token,
+                    TabletReplicas::resolve(ids.empty() ? NULL : &ids[0], ids.size(), hosts) };
+  if (begin == end) {
+    tablets.insert(begin, tablet);
+  } else {
+    *begin = tablet;
+    tablets.erase(begin + 1, end);
+  }
+  return tablet.replicas;
+}
+
+// An element of a tuple or a list: [int length][bytes]
+static bool decode_element(const char** pos, const char* end, StringRef* element) {
+  int32_t size = 0;
+  if (end - *pos < static_cast<ptrdiff_t>(sizeof(int32_t))) return false;
+  *pos = decode_int32(*pos, size);
+  if (size < 0 || end - *pos < size) return false;
+  *element = StringRef(*pos, size);
+  *pos += size;
+  return true;
+}
+
+bool TabletMap::decode_payload(const StringRef& payload, int64_t* first_token,
+                               int64_t* last_token, TabletReplicaIds* ids) {
+  const char* pos = payload.data();
+  const char* end = payload.data() + payload.size();
+  StringRef first, last, list;
+  if (!decode_element(&pos, end, &first) || first.size() != sizeof(int64_t) ||
+      !decode_element(&pos, end, &last) || last.size() != sizeof(int64_t) ||
+      !decode_element(&pos, end, &list)) {
+    return false;
+  }
+  decode_int64(first.data(), *first_token);
+  decode_int64(last.data(), *last_token);
+
+  pos = list.data();
+  end = list.data() + list.size();
+  int32_t count = 0;
+  if (end - pos < static_cast<ptrdiff_t>(sizeof(int32_t))) return false;
+  pos = decode_int32(pos, count);
+  if (count < 0) return false;
+  ids->clear();
+  for (int32_t i = 0; i < count; ++i) {
+    StringRef replica, host_id, shard;
+    if (!decode_element(&pos, end, &replica)) return false;
+    const char* replica_pos = replica.data();
+    const char* replica_end = replica.data() + replica.size();
+    if (!decode_element(&replica_pos, replica_end, &host_id) || host_id.size() != 16 ||
+        !decode_element(&replica_pos, replica_end, &shard) || shard.size() != sizeof(int32_t)) {
+      return false;
+    }
+    TabletReplicaId id;
+    decode_uuid(host_id.data(), &id.host_id);
+    decode_int32(shard.data(), id.shard);
+    ids->push_back(id);
+  }
+  return true;
+}
