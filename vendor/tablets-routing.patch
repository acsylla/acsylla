+namespace datastax { namespace internal { namespace core {
+
+/**
+ * A replica of a tablet as ScyllaDB names it.
+ */
+struct TabletReplicaId {
+  CassUuid host_id;
+  int32_t shard;
+};
+
+typedef SmallVector<TabletReplicaId, 8> TabletReplicaIds;
+
+/**
+ * The hosts that requests can be sent to, the connection pool manager of a request processor.
+ */
+class TabletHostResolver {
+public:
+  virtual ~TabletHostResolver() {}
+
+  /**
+   * Find a host with a connection pool by its host ID.
+   *
+   * @return The host or null if no pool connects to it.
+   */
+  virtual Host::Ptr find_host(const CassUuid& host_id) const = 0;
+
+  /**
+   * Changes every time a connection pool is added or removed, so the replicas of a tablet are
+   * looked up again only after that.
+   */
+  virtual uint64_t pools_version() const = 0;
+};
+
+/**
+ * Replicas of a tablet: the hosts and the shard of the tablet on each of them.
+ */
+class TabletReplicas : public RefCounted<TabletReplicas> {
+public:
+  typedef SharedRefPtr<const TabletReplicas> ConstPtr;
+
+  /**
+   * Find the hosts of the replicas. A replica without a pool (e.g. in an ignored data center or
+   * one that is still connecting) is left out.
+   */
+  static ConstPtr resolve(const TabletReplicaId* ids, size_t count,
+                          const TabletHostResolver& hosts);
+
+  const CopyOnWriteHostVec& hosts() const { return hosts_; }
+
+  /**
+   * The shard of the tablet on a host.
+   *
+   * @param host A host.
+   * @return The shard or -1 if the host is not a replica of the tablet.
+   */
+  int32_t shard(const Host* host) const;
+
+  /**
+   * Whether the replicas are the ones ScyllaDB sent, including the hosts without a pool.
+   */
+  bool has_ids(const TabletReplicaIds& ids) const;
+
+  /**
+   * Whether the hosts may have changed: a replica without a pool may have one now, or a replica
+   * came back with another address (the same host ID, a new host and pool).
+   */
+  bool is_stale(const TabletHostResolver& hosts) const {
+    return pools_version_ != hosts.pools_version();
+  }
+
+  const Vector<TabletReplicaId>& ids() const { return ids_; }
+
+private:
+  TabletReplicas(const TabletReplicaId* ids, size_t count, uint64_t pools_version)
+      : hosts_(new HostVec())
+      , ids_(ids, ids + count)
+      , pools_version_(pools_version) {}
+
+  CopyOnWriteHostVec hosts_;
+  Vector<int32_t> shards_;
+  Vector<TabletReplicaId> ids_;
+  uint64_t pools_version_;
+};
+
+/**
+ * Tablets of the tables with tablets, learned from the "tablets-routing-v1" custom payload that
+ * ScyllaDB sends in the result of a request routed to a wrong node or shard (see
+ * docs/dev/protocol-extensions.md in ScyllaDB). Every request processor has its own map, so it is
+ * used from a single thread without locking.
+ */
+class TabletMap {
+public:
+  bool empty() const { return tables_.empty(); }
+
+  /**
+   * Find the replicas of the tablet that owns a token. The replicas are looked up again if a pool
+   * was added or removed since, ScyllaDB would not send the tablet again while requests reach the
+   * replicas that are known.
+   *
+   * @return The replicas or NULL if the tablet is not known yet.
+   */
+  TabletReplicas::ConstPtr find(const StringRef& keyspace, const StringRef& table, int64_t token,
+                                const TabletHostResolver& hosts);
+
+  /**
+   * Add a tablet that ScyllaDB sent, the tablets it overlaps are replaced. Nothing changes if the
+   * same tablet is already known, ScyllaDB sends it for every request routed to a wrong shard.
+   *
+   * @param first_token The token before the first one of the tablet.
+   * @param last_token The last token of the tablet.
+   * @param ids The host IDs and shards of the replicas.
+   * @return The replicas of the added tablet or NULL if it was known.
+   */
+  TabletReplicas::ConstPtr update(const StringRef& keyspace, const StringRef& table,
+                                  int64_t first_token, int64_t last_token,
+                                  const TabletReplicaIds& ids, const TabletHostResolver& hosts);
+
+  /**
+   * Decode the "tablets-routing-v1" payload: tuple<bigint, bigint, list<tuple<uuid, int>>>.
+   *
+   * @param payload The value of the payload.
+   * @param first_token The token before the first one of the tablet.
+   * @param last_token The last token of the tablet.
+   * @param ids The host IDs and shards of the replicas.
+   * @return Returns false if the payload is malformed.
+   */
+  static bool decode_payload(const StringRef& payload, int64_t* first_token, int64_t* last_token,
+                             TabletReplicaIds* ids);
+
+private:
+  struct Tablet {
+    int64_t first_token; // Exclusive
+    int64_t last_token;  // Inclusive
+    TabletReplicas::ConstPtr replicas;
+  };
+
+  // Tablets do not overlap and are sorted by token
+  typedef Vector<Tablet> TabletVec;
+
+  const String& table_key(const StringRef& keyspace, const StringRef& table) const;
+
+  Map<String, TabletVec> tables_;
+  mutable String key_; // Reused, so finding a tablet does not allocate
+};
