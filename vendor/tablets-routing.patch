+    if (host->has_host_id() && host->host_id().time_and_version == host_id.time_and_version &&
+        host->host_id().clock_seq_and_node == host_id.clock_seq_and_node) {
+      if (it->second->has_connections()) return host;
+      if (!found) found = host;
+    }
+  }
+  return found;
