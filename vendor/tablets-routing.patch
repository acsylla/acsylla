+bool RequestHandler::tablet_table(StringRef* keyspace, StringRef* table) const {
+  const Request* routed = request();
+  if (routed->opcode() == CQL_OPCODE_BATCH) {
+    // A batch is routed by the first of its statements with a routing key
+    const BatchRequest::StatementVec& statements =
+        static_cast<const BatchRequest*>(routed)->statements();
+    routed = NULL;
+    String routing_key;
+    for (BatchRequest::StatementVec::const_iterator it = statements.begin(),
+                                                    end = statements.end();
+         it != end; ++it) {
+      if ((*it)->get_routing_key(&routing_key)) {
+        routed = it->get();
+        break;
+      }
+    }
+    if (routed == NULL) return false;
+  }
+  // Only a bound statement knows its table, from the metadata of its prepared statement
+  if (routed->opcode() != CQL_OPCODE_EXECUTE) return false;
+  const ResultResponse::ConstPtr& prepared =
+      static_cast<const ExecuteRequest*>(routed)->prepared()->result();
+  *keyspace = prepared->keyspace();
+  *table = prepared->table();
+  if ((keyspace->empty() || table->empty()) && prepared->metadata() &&
+      prepared->metadata()->column_count() > 0) {
+    // Without the global table spec every bound variable has its own
+    const ColumnDefinition& column = prepared->metadata()->get_column_definition(0);
+    *keyspace = column.keyspace;
+    *table = column.table;
+  }
+  return !keyspace->empty() && !table->empty();
+}
+
+void RequestHandler::update_tablets(const Response::Ptr& response, Protected) {
+  const CustomPayloadVec& payload = response->custom_payload();
+  for (CustomPayloadVec::const_iterator it = payload.begin(), end = payload.end(); it != end;
+       ++it) {
+    if (it->name != SCYLLA_TABLETS_ROUTING_V1_PAYLOAD) continue;
+
+    StringRef keyspace, table;
+    if (!tablet_table(&keyspace, &table)) return;
+
+    int64_t first_token, last_token;
+    TabletReplicaIds ids;
+    if (!TabletMap::decode_payload(it->value, &first_token, &last_token, &ids)) {
+      LOG_WARN("Invalid %s custom payload", SCYLLA_TABLETS_ROUTING_V1_PAYLOAD);
+      return;
+    }
+    TabletReplicas::ConstPtr replicas =
+        manager_->tablets().update(keyspace, table, first_token, last_token, ids, *manager_);
+    if (replicas) {
+      LOG_DEBUG("Tablet (%lld, %lld] of %.*s.%.*s has %u of %u replicas with a pool",
+                static_cast<long long>(first_token), static_cast<long long>(last_token),
+                static_cast<int>(keyspace.size()), keyspace.data(), static_cast<int>(table.size()),
+                table.data(), static_cast<unsigned>(replicas->hosts()->size()),
+                static_cast<unsigned>(ids.size()));
+    }
+    return;
+  }
+}
